# Copia este archivo a .env y ajusta si hace falta. Nunca commitees el .env real.

PORT=3000
NODE_ENV=development

# --- Si usas Neon (recomendado) ---
# MIGRATE_DATABASE_URL: pega tal cual el connection string que Neon te da para
# tu rama "dev" (algo como postgres://neondb_owner:xxxx@ep-xxxx.neon.tech/neondb?sslmode=require).
# Ese rol pertenece a neon_superuser, que incluye CREATEROLE y BYPASSRLS —
# es el equivalente al superusuario que usarías en un Postgres propio.
#
# DATABASE_URL: apunta al rol almuerzo_app, que las migraciones (0003_rls.sql)
# crean DENTRO de esa misma base con un simple CREATE ROLE. Los roles creados
# así en Neon NO heredan neon_superuser ni BYPASSRLS — quedan como un rol
# normal de Postgres, que es justo lo que necesitamos para que RLS aplique
# de verdad. Ajusta host/db para que coincidan con tu rama, cambiando solo
# el usuario y la contraseña.

MIGRATE_DATABASE_URL=postgres://neondb_owner:TU_PASSWORD_DE_NEON@TU_HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://almuerzo_app:almuerzo_app_dev@TU_HOST.neon.tech/neondb?sslmode=require

# Rol con BYPASSRLS para el back office (ámbito PLATAFORMA, Sprint 2). Lo crea
# migrations/0004_contratos_y_rol_plataforma.sql — mismo host/base que arriba,
# solo cambia el usuario y la contraseña.
PLATFORM_DATABASE_URL=postgres://almuerzo_platform:almuerzo_platform_dev@TU_HOST.neon.tech/neondb?sslmode=require

# --- Si prefieres Postgres local o Docker en vez de Neon ---
# Comenta las tres líneas de arriba y descomenta estas:
# MIGRATE_DATABASE_URL=postgres://almuerzo:almuerzo_dev@localhost:5432/almuerzo
# DATABASE_URL=postgres://almuerzo_app:almuerzo_app_dev@localhost:5432/almuerzo
# PLATFORM_DATABASE_URL=postgres://almuerzo_platform:almuerzo_platform_dev@localhost:5432/almuerzo

# --- Guarda del seed (Sprint 20) ---
# `npm run seed` siembra datos de DEMO, incluido un SUPERADMIN cuya contraseña
# está publicada en este repositorio. Para que no se siembre por accidente en
# una base real, el script aborta si la base destino no es localhost.
# Si desarrollas contra Neon (lo normal aquí), declara el host de TU rama de
# desarrollo — es el mismo que aparece en las URLs de arriba. Si lo omites, el
# propio mensaje de error te da la línea ya escrita para copiar.
SEED_HOST_PERMITIDO=TU_HOST.neon.tech

# Genera el tuyo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_valor_aleatorio_largo
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Notificaciones por email (Sprint 9.2) ---
# Opcionales: sin estas dos, las notificaciones quedan registradas en
# notificacion_enviada con estado OMITIDA, sin romper ningún request.
# Crea una cuenta gratuita en https://resend.com y pega tu API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- CORS (Sprint 10) ---
# Orígenes desde donde el navegador puede llamar a esta API, separados por
# coma. Default: el dev server de Vite del frontend (frontend/).
# En producción se les agrega https:// automáticamente si vienen sin esquema
# (Render entrega el hostname pelado) — ver src/main.ts.
CORS_ORIGENES=http://localhost:5176

# URL pública del frontend, para armar los enlaces que se mandan por correo
# (invitación y recuperación de contraseña). En producción es OBLIGATORIA: sin
# ella la API no arranca, a propósito — antes arrancaba bien y mandaba correos
# apuntando a localhost, que nadie podía usar.
FRONTEND_URL=http://localhost:5176

# --- Despliegue (Sprint 20) ---
# Activa 'trust proxy' en Express, para que el rate limit del login cuente por
# IP real y no por la del balanceador. Ponlo en 'true' SOLO si hay un proxy
# de verdad delante (Render, nginx). En local déjalo así: activarlo sin proxy
# permite falsificar la IP con un header y evadir el rate limit.
CONFIAR_EN_PROXY=false
