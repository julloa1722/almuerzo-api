{
  "name": "almuerzo-api",
  "version": "0.1.0",
  "description": "Sprint 1 — fundacion tecnica e identidad. Backend de la plataforma de almuerzo corporativo.",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "migrate": "node scripts/migrate.js",
    "migrate:down": "node scripts/migrate.js down",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smoke-test.js",
    "prueba-e2e": "node scripts/prueba-e2e.js",
    "test": "node test/tenant-isolation.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
